{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C with optional D: aligned probe token",
  "type": "object",
  "properties": {
    "sample_id": {
      "type": "integer",
      "minimum": 0
    },
    "token_position": {
      "type": "integer",
      "minimum": 0
    },
    "layer_id": {
      "type": "string",
      "pattern": "^(encoder|decoder)_layer_[0-9]{2}$"
    },
    "selected_experts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 63
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "expert_activation_sums": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 64,
      "maxItems": 64
    }
  },
  "required": [
    "sample_id",
    "token_position",
    "layer_id",
    "selected_experts"
  ],
  "additionalProperties": false
}
