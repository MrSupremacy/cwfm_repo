{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-condition metric payload",
  "type": "object",
  "required": [
    "protocol",
    "analysis",
    "condition",
    "state",
    "metric_group",
    "model",
    "layers"
  ],
  "properties": {
    "protocol": {
      "type": "string"
    },
    "analysis": {
      "type": "string"
    },
    "condition": {
      "type": "object"
    },
    "state": {
      "type": "object"
    },
    "metric_group": {
      "enum": [
        "performance",
        "load_balance",
        "churn",
        "oracle_overlap",
        "adjusted_overlap",
        "activation_coverage",
        "oracle_resolution"
      ]
    },
    "model": {
      "type": "object"
    },
    "layers": {
      "type": "object"
    },
    "previous_state": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
